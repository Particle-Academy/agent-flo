{
    "name": "particle-academy/agent-flo",
    "description": "Headless subagent for Laravel apps on prism-harness that reads, diagnoses, authors and runs fancy-flow flows. Host-owned flows and runs behind a store contract, configurable names, proposals by default, and run data treated as hostile.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "agents", "subagent", "workflow", "fancy-flow", "prism", "human-plus"],
    "homepage": "https://github.com/Particle-Academy/agent-flo",
    "support": {
        "issues": "https://github.com/Particle-Academy/agent-flo/issues",
        "source": "https://github.com/Particle-Academy/agent-flo"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "particle-academy/fancy-flow-mcp": ">=0.6 <2.0",
        "particle-academy/fancy-flow-php": ">=0.66 <2.0",
        "particle-academy/prism": ">=0.143 <1.0",
        "particle-academy/prism-harness": ">=0.22 <1.0"
    },
    "require-dev": {
        "laravel/framework": "^13.30",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "AgentFlo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentFlo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "@php tests/lint.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgentFlo\\Laravel\\AgentFloServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
